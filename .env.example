# Cyber Container Platform - Environment Configuration
# Copy this file to .env and customize for your deployment

# Application Environment (development | production)
ENVIRONMENT=production

# Backend Configuration
PORT=8080
WS_PORT=8081
GIN_MODE=release
LOG_LEVEL=info
DATABASE_PATH=./data/cyber.db

# Security - REQUIRED for production
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=24h
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m

# Admin Account - REQUIRED for production first boot
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Registration (disabled by default for commercial deployments)
ALLOW_REGISTRATION=false

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost,https://localhost,http://localhost:3000

# SSL (optional - typically handled by nginx)
SSL_ENABLED=false
CERT_PATH=./certs/server.crt
KEY_PATH=./certs/server.key

# Frontend Configuration
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost/ws
